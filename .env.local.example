WORF_API_URL=https://api.yourworfserver.com

# Legacy password-flow client (used by /api/auth/logout). Keep as-is.
WORF_CLIENT_ID=your-client-uuid
WORF_CLIENT_SECRET=your-client-secret

# OAuth 2.1 redirect-flow client, registered separately with
# `npm run register-oauth-client -- --redirect-uri <callback>`.
# This is a DIFFERENT client from WORF_CLIENT_ID above; never merge the two.
WORF_OAUTH_CLIENT_ID=your-private-key-jwt-client-uuid
WORF_OAUTH_PRIVATE_KEY=your-pkcs8-pem-private-key-with-escaped-\n-line-breaks
WORF_OAUTH_KID=your-registered-jwk-kid
WORF_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback

WORF_DEVICE_TYPE=web

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=hu
NEXT_PUBLIC_API_PROXY_URL=/api/proxy
